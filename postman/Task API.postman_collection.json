{
  "info": {
    "name": "Task API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion ordenada para Reviewer Experience Sprint 4.1."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_token", "value": "" },
    { "key": "executor_token", "value": "" },
    { "key": "auditor_token", "value": "" },
    { "key": "executor_id", "value": "" },
    { "key": "auditor_id", "value": "" },
    { "key": "task_id", "value": "" },
    { "key": "executor_email", "value": "executor@test.com" },
    { "key": "auditor_email", "value": "auditor@test.com" },
    { "key": "executor_password", "value": "ChangeMe123!" },
    { "key": "auditor_password", "value": "ChangeMe123!" }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "01 - Get Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "02 - Get Health DB",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/db"
          }
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "01 - Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.token) {",
                  "  pm.collectionVariables.set('admin_token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Auth Me (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "03 - Change Password (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Admin123\",\n  \"new_password\": \"Admin123\"\n}"
            },
            "url": "{{base_url}}/api/auth/change-password"
          }
        }
      ]
    },
    {
      "name": "03 - Users",
      "item": [
        {
          "name": "01 - Create Executor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Executor User\",\n  \"email\": \"{{executor_email}}\",\n  \"role\": \"EXECUTOR\"\n}"
            },
            "url": "{{base_url}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.user && data.data.user.id) {",
                  "  pm.collectionVariables.set('executor_id', data.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create Auditor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Auditor User\",\n  \"email\": \"{{auditor_email}}\",\n  \"role\": \"AUDITOR\"\n}"
            },
            "url": "{{base_url}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.user && data.data.user.id) {",
                  "  pm.collectionVariables.set('auditor_id', data.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/users"
          }
        },
        {
          "name": "04 - Login Executor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{executor_email}}\",\n  \"password\": \"{{executor_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.token) {",
                  "  pm.collectionVariables.set('executor_token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Login Auditor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{auditor_email}}\",\n  \"password\": \"{{auditor_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.token) {",
                  "  pm.collectionVariables.set('auditor_token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Restriction: Admin Cannot Create Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Admin\",\n  \"email\": \"invalid-admin@test.com\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{base_url}}/api/users"
          }
        }
      ]
    },
    {
      "name": "04 - Tasks - Admin",
      "item": [
        {
          "name": "01 - Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Task Reviewer\",\n  \"description\": \"Created by admin\",\n  \"due_date\": \"2026-12-30T10:00:00Z\",\n  \"assigned_to\": {{executor_id}}\n}"
            },
            "url": "{{base_url}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.data && data.data.id) {",
                  "  pm.collectionVariables.set('task_id', data.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - List Tasks (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/tasks"
          }
        },
        {
          "name": "03 - Restriction: Admin Cannot Assign Task To Auditor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid assignment\",\n  \"description\": \"Should fail\",\n  \"due_date\": \"2026-12-30T10:00:00Z\",\n  \"assigned_to\": {{auditor_id}}\n}"
            },
            "url": "{{base_url}}/api/tasks"
          }
        },
        {
          "name": "04 - Restriction: Admin Cannot Edit IN_PROGRESS Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Edit blocked\"\n}"
            },
            "url": "{{base_url}}/api/tasks/{{task_id}}"
          }
        },
        {
          "name": "05 - Restriction: Admin Cannot Delete COMPLETED Task",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/tasks/{{task_id}}"
          }
        }
      ]
    },
    {
      "name": "05 - Tasks - Executor",
      "item": [
        {
          "name": "01 - List My Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" }
            ],
            "url": "{{base_url}}/api/tasks/my"
          }
        },
        {
          "name": "02 - Get My Task By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" }
            ],
            "url": "{{base_url}}/api/tasks/my/{{task_id}}"
          }
        },
        {
          "name": "03 - Update My Task Status (Valid Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": "{{base_url}}/api/tasks/my/{{task_id}}/status"
          }
        },
        {
          "name": "04 - Update My Task Status (Invalid Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ASSIGNED\"\n}"
            },
            "url": "{{base_url}}/api/tasks/my/{{task_id}}/status"
          }
        },
        {
          "name": "05 - Update My Task Status To COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": "{{base_url}}/api/tasks/my/{{task_id}}/status"
          }
        },
        {
          "name": "06 - Add Comment To Expired Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"No pude completar por dependencias externas\"\n}"
            },
            "url": "{{base_url}}/api/tasks/my/{{task_id}}/comments"
          }
        },
        {
          "name": "07 - Restriction: Executor Cannot Access Foreign Task",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{executor_token}}" }
            ],
            "url": "{{base_url}}/api/tasks/my/999999"
          }
        }
      ]
    },
    {
      "name": "06 - Audit",
      "item": [
        {
          "name": "01 - Audit Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auditor_token}}" }
            ],
            "url": "{{base_url}}/api/audit/tasks"
          }
        },
        {
          "name": "02 - Restriction: Auditor Cannot Modify Resources",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auditor_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"description\": \"No access\",\n  \"due_date\": \"2026-12-30T10:00:00Z\",\n  \"assigned_to\": {{executor_id}}\n}"
            },
            "url": "{{base_url}}/api/tasks"
          }
        }
      ]
    }
  ]
}
